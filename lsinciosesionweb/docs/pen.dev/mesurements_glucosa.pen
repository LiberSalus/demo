                                          "content": "* mg/dL: miligramos por decilitro (unidad para medir la concentración de azúcar)",
                                          "fontFamily": "Roboto",
                                          "fontSize": 12,
                                          "fontWeight": "normal"
                                        }
                                      ]
                                    }
                                  ]
                                }
