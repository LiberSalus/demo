                        {
                          "type": "text",
                          "id": "e3FicL",
                          "name": "Interacción:",
                          "fill": "#8ca5bdff",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Interacción:",
                          "fontFamily": "Inter",
                          "fontSize": 24,
                          "fontWeight": "700"
                        },
                        {
                          "type": "text",
                          "id": "D6vEMl",
                          "name": "El botón \"Finalizar registro\" dirige al usuario al flujo de Onboarding. El botón \"Agregar un perfil\" inicia el flujo de registro de una persona bajo cuidado. Este flujo permite registrar únicamente un perfil bajo cuidado. Al finalizar el registro de la persona bajo cuidado, el usuario continúa automáticamente con el flujo de Onboarding. Los perfiles adicionales solo podrán registrarse desde la sección \"Mis perfiles\" una vez que el usuario haya ingresado a la plataforma.",
                          "fill": "#334155ff",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "El botón \"Finalizar registro\" dirige al usuario al flujo de Onboarding. \nEl botón \"Agregar un perfil\" inicia el flujo de registro de una persona bajo cuidado. \nEste flujo permite registrar únicamente un perfil bajo cuidado. \nAl finalizar el registro de la persona bajo cuidado, el usuario continúa automáticamente con el flujo de Onboarding. \nLos perfiles adicionales solo podrán registrarse desde la sección \"Mis perfiles\" una vez que el usuario haya ingresado a la plataforma.",
                          "fontFamily": "Roboto",
                          "fontSize": 24,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "line",
                      "id": "bBz0t",
                      "name": "Line 293",
                      "rotation": -0.000005008956130975318,
