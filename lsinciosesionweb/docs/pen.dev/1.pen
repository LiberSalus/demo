                      "height": 0,
                      "stroke": "#d6e6f5ff",
                      "strokeWidth": 2
                    },
                    {
                      "type": "frame",
                      "id": "Q9ZNKV",
                      "name": "Frame 6548",
                      "width": 815,
                      "layout": "vertical",
                      "gap": 8,
                      "layoutIncludeStroke": true,
                      "children": [
                        {
                          "type": "text",
                          "id": "T7eLH",
                          "name": "REG-13",
                          "fill": "#007cbaff",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "REG-13",
                          "fontFamily": "Inter",
                          "fontSize": 32,
                          "fontWeight": "700"
                        },
                        {
                          "type": "text",
                          "id": "EJsvy",
                          "name": "Interacción:",
                          "fill": "#8ca5bdff",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Interacción:",
                          "fontFamily": "Inter",
                          "fontSize": 24,
                          "fontWeight": "700"
                        },
                        {
                          "type": "text",
                          "id": "aUy0Y",
                          "name": "La información capturada y validada en este formulario corresponde al perfil de la persona bajo cuidado y no modifica la información del titular de la cuenta. El usuario debe seleccionar la relación o parentesco con la persona titular. El usuario debe capturar una CURP válida para continuar con el formulario. Una vez validada la CURP, la información personal se completa automáticamente. El usuario debe completar todos los campos obligatorios para habilitar el botón \"Continuar\". Si la CURP es inválida, no se autocompleta la información y no es posible continuar. ——————————————————————————————————————————— Si el usuario accede desde la pantalla **REG-17** — Validación de datos , el botón “Continuar” se reemplaza por el botón “Guardar”. El botón “Guardar” permanece en estado Disabled hasta que el usuario realice al menos un cambio en el formulario. Al seleccionar \"Guardar\", la información se actualiza y el usuario regresa automáticamente a la pantalla **REG-17**.",
                          "fill": "#334155ff",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "La información capturada y validada en este formulario corresponde al perfil de la persona bajo cuidado y no modifica la información del titular de la cuenta.\nEl usuario debe seleccionar la relación o parentesco con la persona titular.\nEl usuario debe capturar una CURP válida para continuar con el formulario.\nUna vez validada la CURP, la información personal se completa automáticamente.\nEl usuario debe completar todos los campos obligatorios para habilitar el botón \"Continuar\".\nSi la CURP es inválida, no se autocompleta la información y no es posible continuar.\n———————————————————————————————————————————\nSi el usuario accede desde la pantalla **REG-17**  — Validación de datos , el botón “Continuar” se reemplaza por el botón “Guardar”.\nEl botón “Guardar” permanece en estado Disabled hasta que el usuario realice al menos un cambio en el formulario.\n Al seleccionar \"Guardar\", la información se actualiza y el usuario regresa automáticamente a la pantalla **REG-17**.",
                          "fontFamily": "Roboto",
                          "fontSize": 24,
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                },
